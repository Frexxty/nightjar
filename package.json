{
  "name": "stratus",
  "productName": "Stratus",
  "version": "0.2.0",
  "private": true,
  "description": "A desktop SoundCloud client UI in the style of Cider, with a pluggable backend.",
  "author": "Frexxty",
  "license": "MIT",
  "homepage": "https://github.com/Frexxty/stratus",
  "repository": "github:Frexxty/stratus",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "dev:web": "vite --mode web",
    "build:web": "vue-tsc --noEmit && vite build --mode web",
    "preview:web": "vite preview --mode web --port 4173",
    "deploy:web": "npm run build:web && npx wrangler@latest deploy --config web/wrangler.jsonc",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.* \"test/*.test.*\"",
    "dist": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "dev.stratus.app",
    "productName": "Stratus",
    "copyright": "Copyright © 2026 Frexxty",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "tray.png",
          "trayTemplate.png",
          "trayTemplate@2x.png"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Frexxty",
      "repo": "stratus",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Stratus-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stratus",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "Stratus-Setup-${arch}.exe"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "hls.js": "^1.7.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.3.2",
    "semver": "~7.7.3"
  }
}
