{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The web player at nightjar-app.k3s.lat: static files from `npm run build:web`,
  // plus worker.js, which moves visitors of the old stratus-app.k3s.lat over.
  // Deploy with `npm run deploy:web` from the repo root. The Worker keeps its
  // pre-rename name, so this updates the existing one instead of creating another.
  "name": "stratus-app",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "account_id": "f2cf5d525fceb6c6c5fccbbd10a94bb4",
  "workers_dev": true,
  "routes": [
    { "pattern": "nightjar-app.k3s.lat", "custom_domain": true },
    // The old address. worker.js redirects it, except /spotify-callback.
    { "pattern": "stratus-app.k3s.lat", "custom_domain": true }
  ],
  "assets": {
    "directory": "../dist-web",
    "binding": "ASSETS",
    // The app uses hash routes, so this only matters for stray paths: they get the app, not a 404.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    // The Worker has to see every request to tell the two hosts apart.
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
